<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <include android:id="@+id/columns" layout="@layout/view_valuation_columns" />
        <net.cachapa.expandablelayout.ExpandableLayout android:id="@+id/expandableLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" app:el_duration="250" app:el_expanded="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:background="@color/tab_surface">
                <TextView android:id="@+id/dividend" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:textSize="14sp" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:id="@+id/pbRatio" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:textSize="14sp" android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
        </net.cachapa.expandablelayout.ExpandableLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/tab_surface" />
    </LinearLayout>
</layout>